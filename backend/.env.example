# Copy to .env for local development. Never commit .env or real credentials.

# development | test | production
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# PostgreSQL connection string for ITEIME-owned data. Required when
# NODE_ENV=production. Without it (development only), readiness reports
# "not_configured" and sign-in answers 503.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/iteime_dev

# Tests only: a SEPARATE local database whose name ends in _test. The test
# run migrates it and empties its tables. Without it, database tests skip.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/iteime_dev_test

# Browser origins allowed to call the API (the dashboards), comma separated.
# Empty means no cross-origin browser access.
CORS_ORIGINS=

# Which proxies' X-Forwarded-For to trust: false, true, or a hop count (e.g. 1).
TRUST_PROXY=false

# Requests per IP per minute across the API (health checks are exempt).
RATE_LIMIT_PER_MINUTE=300

# CHL integration. The CHL API contract is not yet confirmed (see
# docs/requirements/open-questions.md); leave unset until it is.
# CHL_BASE_URL=
CHL_TIMEOUT_MS=10000

# Who confirms sign-in credentials (ADR-0010):
#   none - no provider; sign-in answers 503 CHL_NOT_CONFIGURED (default)
#   fake - the FAKE CHL identity provider: synthetic accounts for local
#          development and tests only. Refused when NODE_ENV=production.
CHL_IDENTITY_PROVIDER=none

# Access-token lifetime in minutes (5-120), and the absolute length of a
# sign-in in hours (1-24; SRD 5.3 requires sign-out after 24 hours).
ACCESS_TOKEN_TTL_MINUTES=30
SESSION_TTL_HOURS=24
