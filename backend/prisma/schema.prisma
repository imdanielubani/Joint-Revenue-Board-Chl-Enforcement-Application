// ITEIME-owned data only. CHL-owned records (agents, vehicles, E-Tags, trips,
// tariffs, payments) are read through the CHL integration, never copied here
// unless a documented data-sharing decision says so (ADR-0007).
//
// Phase 3 adds only the platform tables approved for it: sessions (ADR-0010)
// and the audit log. Business tables arrive module by module in Phase 4, from
// docs/architecture/data-model-proposal.md once reviewed.
//
// The connection URL is configured in prisma.config.ts (Prisma 7).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// A signed-in session issued by ITEIME after CHL confirmed the credentials
/// (ADR-0010). Tokens are stored only as SHA-256 hashes.
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  /// CHL account ID (a reference, not a copy of the account: ADR-0007).
  principalId      String    @map("principal_id")
  /// mobile | monitoring: the client this session may use.
  client           String
  /// Snapshot of name, email, role, organization and scope from CHL at sign-in
  /// or last refresh. Used for authorization and audit; never authoritative.
  principal        Json
  accessTokenHash  String    @unique @map("access_token_hash")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  accessExpiresAt  DateTime  @map("access_expires_at") @db.Timestamptz(3)
  /// Absolute end of the sign-in: at most 24 hours after it (SRD §5.3).
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  refreshedAt      DateTime? @map("refreshed_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason    String?   @map("revoked_reason")

  @@index([principalId])
  @@map("sessions")
}

/// Append-only security and business audit trail (SRD §28; T2.7, T18.2;
/// MON §12.4: no editing or deleting). Updates and deletes are blocked by a
/// trigger in the migration. This is not tamper-proof storage (Q-OPS-2).
model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  /// principal | system | anonymous
  actorType  String   @map("actor_type")
  actorId    String?  @map("actor_id")
  actorRole  String?  @map("actor_role")
  /// Dotted action name, for example auth.login.
  action     String
  /// success | failure | denied
  outcome    String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  requestId  String?  @map("request_id")
  ip         String?
  /// Extra context, redacted before it is stored.
  details    Json?

  @@index([occurredAt(sort: Desc), id(sort: Desc)])
  @@index([actorId, occurredAt(sort: Desc)])
  @@index([action, occurredAt(sort: Desc)])
  @@map("audit_events")
}
