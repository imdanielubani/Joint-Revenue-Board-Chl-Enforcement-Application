# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL connection string. Optional until the database step; when empty
# the readiness check reports the database as "not configured".
DATABASE_URL=postgres://iteime:iteime@localhost:5432/iteime

# Which CHL adapter to use:
#   mock - sample CHL data, no CHL access needed (default)
#   http - the real CHL backend (needs CHL_BASE_URL and CHL_API_KEY)
CHL_ADAPTER=mock

# Real CHL backend (CHL_ADAPTER=http). Values come from the CHL team.
CHL_BASE_URL=
CHL_API_KEY=
CHL_TIMEOUT_MS=10000

# Mock only: how long each CHL call takes, to imitate a real network.
CHL_MOCK_DELAY_MS=0
