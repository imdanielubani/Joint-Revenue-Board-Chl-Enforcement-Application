# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
# Which deployment this is: development, staging or production. Staging and
# production need NODE_ENV=production; production also needs CHL_ADAPTER=http.
APP_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL connection string (required).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/iteimedb

# Which CHL adapter to use:
#   mock - sample CHL data, no CHL access needed (default)
#   http - the real CHL backend (needs CHL_BASE_URL and CHL_API_KEY)
CHL_ADAPTER=mock

# Real CHL backend (CHL_ADAPTER=http). Values come from the CHL team.
CHL_BASE_URL=
CHL_API_KEY=
CHL_TIMEOUT_MS=10000

# Mock only: how long each CHL call takes, to imitate a real network.
CHL_MOCK_DELAY_MS=0

# Sessions: access tokens are refreshed by the app; a sign-in lasts at most
# SESSION_TTL_HOURS (SRD §5.3: 24 hours).
ACCESS_TOKEN_TTL_MINUTES=30
SESSION_TTL_HOURS=24

# Tests only: a separate database that the tests empty and refill.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/iteimedb_test

# Behind a load balancer: which proxies to trust for the client's address.
# A number is the hops to trust (e.g. 1); default: private-network proxies.
TRUST_PROXY=

# Browser origins allowed to call the API (the admin dashboards), comma
# separated, or *. Default: any in development, none elsewhere.
CORS_ORIGINS=
