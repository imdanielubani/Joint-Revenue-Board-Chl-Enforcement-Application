# Production: set these in the hosting platform's secret settings (or copy
# to deploy/production.env, never committed). Officers' app points here.
NODE_ENV=production
APP_ENV=production
PORT=4000
LOG_LEVEL=info

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/iteime?sslmode=require

# Production must use the real CHL backend; the server refuses to start
# with the sample data.
CHL_ADAPTER=http
CHL_BASE_URL=https://CHL-PRODUCTION-ADDRESS
CHL_API_KEY=
CHL_TIMEOUT_MS=10000

ACCESS_TOKEN_TTL_MINUTES=30
SESSION_TTL_HOURS=24

TRUST_PROXY=1
# The production admin dashboards' addresses, comma separated.
CORS_ORIGINS=
