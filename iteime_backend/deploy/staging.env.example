# Staging: copy to deploy/staging.env (never committed) or set these in the
# hosting platform's settings. Testers' builds of the app point here.
NODE_ENV=production
APP_ENV=staging
PORT=4000
LOG_LEVEL=info

# Staging's own database (never production's). Managed databases usually
# need TLS: add ?sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/iteime_staging?sslmode=require

# Sample CHL data until the CHL team gives a test (sandbox) address; then
# CHL_ADAPTER=http with the sandbox address and key.
CHL_ADAPTER=mock
CHL_BASE_URL=
CHL_API_KEY=
CHL_TIMEOUT_MS=10000

ACCESS_TOKEN_TTL_MINUTES=30
SESSION_TTL_HOURS=24

# One load balancer / reverse proxy in front.
TRUST_PROXY=1
# The staging admin dashboards' addresses, comma separated.
CORS_ORIGINS=
