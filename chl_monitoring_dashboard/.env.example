# Copy to .env.local (ignored by git) and adjust. Vite only exposes VITE_ settings.

# development | staging | production
VITE_APP_ENV=development

# true: run on the sample data in src/mocks (not allowed in production).
# false: call the backend at VITE_API_BASE_URL.
VITE_USE_MOCKS=true

# The backend's address. Required when VITE_USE_MOCKS=false; https outside development.
VITE_API_BASE_URL=

# Where "Contact CHL Support" leads: an https:// page or a mailto: address.
# Required in production.
VITE_SUPPORT_URL=
