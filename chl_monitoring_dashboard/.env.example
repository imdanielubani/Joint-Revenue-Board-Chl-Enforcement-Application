# Copy to .env.local (ignored by git) and adjust. Vite only exposes VITE_ settings.

# development | staging | production
VITE_APP_ENV=development

# true: run on the sample data in src/mocks (not allowed in production).
# false: call the backend at VITE_API_BASE_URL.
VITE_USE_MOCKS=true

# The backend's address. Required when VITE_USE_MOCKS=false; https outside development.
VITE_API_BASE_URL=

# Map tiles for the Command centre's location map (https, with {z}, {x} and {y}).
# Defaults to OpenStreetMap's tiles, which suit development and light use only:
# for production, set a tile provider JRB has an agreement with, and its credit.
# Leave VITE_MAP_TILE_URL empty to turn the map off (the list view stays).
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

